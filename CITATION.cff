    url: "https://huggingface.co/datasets/krxi123/asmsense"
    repository: "https://github.com/krxi/asmsense-data"
  - type: software
    title: "asmsense Qwen3-8B LoRA adapter"
    authors:
      - alias: krxi
    url: "https://huggingface.co/krxi123/asmsense-qwen3-8b-lora"
